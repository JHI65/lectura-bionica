# Copia este archivo a .env.local. Ninguna clave secreta debe ir aquí:
# solo variables públicas (VITE_*). Los secretos de Stripe van en Firebase (functions).

# URL pública del sitio, sin barra final (canonical, sitemap). Obligatoria en producción.
VITE_SITE_URL=http://localhost:4173

# Tamaño máximo de archivo en MB (por defecto 25)
VITE_MAX_FILE_MB=20

# Google AdSense. Vacío = no se muestran anuncios (en desarrollo se ven placeholders).
# Formato real: ca-pub-XXXXXXXXXXXXXXXX (solo tras aprobación de AdSense)
VITE_ADSENSE_CLIENT=
# Identificador del bloque de anuncios (solo dígitos). Sin él no se muestra ningún anuncio.
VITE_ADSENSE_SLOT=

# Premium y cuentas. Déjalo en false hasta tener Firebase y Stripe configurados.
VITE_PREMIUM_ENABLED=false

# Firebase (cuentas y estado Premium). Vacío = modo sin cuenta.
# Valores de Project settings → Tu app web. La apiKey de Firebase es pública.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Región de las funciones (por defecto europe-west1)
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Precio mostrado en la sección Premium (debe coincidir con el Price de Stripe)
VITE_PREMIUM_PRICE_LABEL=2,99 €/mes
# Plan anual (debe coincidir con el Price anual de Stripe) y días de prueba anunciados
# (deben coincidir con STRIPE_TRIAL_DAYS del servidor; 0 = sin prueba)
VITE_PREMIUM_YEARLY_PRICE_LABEL=24,99 €/año
VITE_PREMIUM_TRIAL_DAYS=7

# Endpoint propio de analítica (opcional). Vacío = no se envía nada.
VITE_ANALYTICS_ENDPOINT=
