# Parámetros no secretos de las funciones. Copia a functions/.env.<id-del-proyecto>
# (por ejemplo functions/.env.readably-prod). Los secretos (STRIPE_SECRET_KEY y
# STRIPE_WEBHOOK_SECRET) NO van aquí: se guardan con `firebase functions:secrets:set`.
SITE_URL=https://readably.online
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_TRIAL_DAYS=7
